{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@aether/*": [
                "packages/*/dist/index.d.ts",
                "packages/*/src/index.ts",
                "packages/*/src",
                "apps/*/src/index.ts",
                "apps/*/src",
                "apps/*/dist/index.d.ts",
                "apps/*/dist/index.d.cts"
            ]
        }
    },
    "exclude": [
        "docs",
        "node_modules",
        "dist"
    ]
}